<!-- 自定义组件属性名检测 缺少报错在标签名位置,错误名报错在自身位置 -->
<block wx:if="{{attached}}">
	<view id="{{cid}}">
		<!-- ✅  正确示例 -->
		<subExternal
			str="{{rootData}}"
			bind:onTap="subExternal_onTap"
		/>
		<!-- ❌ 缺少属性名 示例 -->
		<subExternal2 />
		<!-- ✅ 通过 inherit 显式继承到 chunkA 的数据可以访问 -->
		<view id="chunkA">
			<view>{{chunkA_useInherit}}</view>
			<!-- ❌ 未继承的父组件数据不可访问 -->
			<view>{{knownData}}</view>
		</view>
	</view>
</block>
