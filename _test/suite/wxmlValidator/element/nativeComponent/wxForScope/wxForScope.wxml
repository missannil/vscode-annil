<!-- 测试目标：wx:for 作用域内的自定义 item/index 变量 -->
<view>
	<!-- ① myItem 在 wx:for 作用域外 → 未知数据 -->
	<view>{{myItem}}</view>
	<!-- ② wx:for 作用域内，myItem 有效（自定义 wx:for-item） -->
	<block
		wx:for="{{items}}"
		wx:for-item="myItem"
		wx:for-index="idx"
	>
		<view>{{myItem}}</view>
		<view>{{idx}}</view>
		<!-- ③ 作用域内的 rootData 仍然有效 -->
		<view>{{outerData}}</view>
	</block>
	<!-- ④ myItem 作用域已离开 → 未知数据 -->
	<view>{{myItem}}</view>
</view>
