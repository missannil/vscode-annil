<!-- Root 数据可用于 CustomComponent 外层条件。 -->
<block wx:if="{{rootVisible}}">
	<subInline></subInline>
</block>
<!-- Chunk 数据只在 ChunkComponent 作用域内有效。 -->
<view id="chunkInline">
	<block wx:if="{{chunkInline_visible}}"></block>
</view>
<block wx:if="{{chunkBlock_visible}}">
	<view id="chunkBlock"></view>
</block>
<block wx:if="{{chunkInline_visible}}"></block>
<!-- CustomComponent 的 isReady 可用于包裹它的 block 条件。 -->
<block wx:if="{{subInline_isReady}}">
	<subInline></subInline>
</block>
