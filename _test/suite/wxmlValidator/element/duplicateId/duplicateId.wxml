<!-- 测试目标：重复 id 按下划线后的末段比较，规范化动态表达式空格，且不受 annil disable 影响。 -->

<!-- 第一个 aaa 不产生诊断 -->
<view id="aaa"></view>
<!-- 重复的 aaa — 产生诊断 -->
<view id="aaa"></view>
<!-- 后缀 aaa 产生诊断 -->
<view id="xxx_aaa"></view>

<!-- annil 注释 对 id 重复检测无效 -->
<!-- annil disable line  这里仍产生重复诊断 -->
<view id="xxx_aaa"></view>

<block
	wx:for="{{list}}"
	wx:key="xxx"
	wx:for-item="item"
	wx:for-index="index"
>
	<!-- {{index}}_aaa 与上面静态 aaa 重复 — 产生诊断 -->
	<view id="{{index}}_aaa"></view>
	<!-- 第一个动态 id：建立 {{index}} 的比较基准，不产生诊断。 -->
	<view id="{{index}}"></view>
	<!-- 与上面重复 产生诊断 -->
	<view id="{{ index }}"></view>
</block>
