{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "removeComments": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // "outDir": "../testOut", // 指定输出文件的目录
    // "rootDir": "./", // 指定输入文件的根目录
    // "noEmit": true,
    // "sourceMap": true,
    "skipDefaultLibCheck": true,
    // "declaration": true,
    // NodeNext 下 esModuleInterop 隐含为 true
    // "resolveJsonModule": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true, // 带有?标志的属性类型不再包含undefined类型
    "strict": true, /* enable all strict type-checking options */
    "paths": {
      "~/*": [
        "./miniprogram/components/*"
      ],
      "@useCommon/*": [
        "./miniprogram/useCommon/*"
      ]
    },
    "types": [
      "hry-types",
      "node",
      "miniprogram-api-typings",
      "mobx",
      "annil"
    ]
  },
  "include": [
    "../out/**/*.ts",
    "./**/*.ts"
  ],
  "exclude": [
    "../out/**/*.ts",
    "node_modules"
  ]
}
