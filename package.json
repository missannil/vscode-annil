{
  "name": "vscode-annil",
  "publisher": "missannil",
  "displayName": "annil",
  "description": "微信小程序原生插件——`annil`的vscode拓展",
  "version": "0.10.20",
  "engines": {
    "vscode": "^1.123.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/missannil/vscode-annil"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "imports": {
    "#deps": {
      "types": "./_src/utils/deps.ts",
      "default": "./out/_src/utils/deps.js"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "wxml",
        "extensions": [
          ".wxml"
        ],
        "aliases": [
          "WXML"
        ]
      }
    ],
    "commands": [
      {
        "command": "annil.fix-all",
        "title": "修复当前组件的错误"
      },
      {
        "command": "annil.check-all",
        "title": "检测所有组件的错误"
      },
      {
        "command": "commentConsole.toggleConsoleComments",
        "title": "Toggle Console Comments"
      },
      {
        "command": "annil.createComponent",
        "title": "新建自定义组件"
      },
      {
        "command": "annil.createPage",
        "title": "新建页面组件"
      },
      {
        "command": "annil.generateMiniTestClass",
        "title": "生成miniTest类"
      }
    ],
    "keybindings": [
      {
        "command": "annil.fix-all",
        "key": "alt+s",
        "mac": "ctrl+s",
        "when": "editorTextFocus"
      },
      {
        "command": "annil.check-all",
        "key": "alt+z",
        "mac": "ctrl+z",
        "when": "editorTextFocus"
      },
      {
        "command": "commentConsole.toggleConsoleComments",
        "key": "ctrl+q",
        "when": "editorTextFocus"
      },
      {
        "command": "annil.generateMiniTestClass",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "annil",
      "properties": {
        "annil.ignoreFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "忽略检查的字段"
        },
        "annil.innerDataPrefix": {
          "type": "string",
          "default": "_",
          "description": "内部字段前缀，以该前缀开头的 data/properties/computed/store/events 字段不会被收集（默认 _）"
        },
        "annil.ignoreTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "忽略检查的标签"
        },
        "annil.allowUnknownAttributes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "允许Wxml标签中书写非对应子组件中定义的属性"
        },
        "annil.jsonConfigKeys": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "json文件中合法的配置项"
        },
        "annil.validDatas": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "wxml检测时允许的数值"
        },
        "annil.testFilePath": {
          "type": "string",
          "default": "miniTest/components",
          "description": "生成的测试文件(*.py)存放的路径，路径相对于工作区根目录"
        },
        "annil.generateAttrs": {
          "type": "array",
          "default": [
            "class",
            "style"
          ],
          "items": {
            "type": "string"
          },
          "description": "生成的测试类时,要生成的属性列表,逗号分隔,例如: [\"mode\",\"src\",\"hidden\",\"value\",\"placeholder\",\"scroll-into-view\"]"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "annil.createComponent",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "annil.createPage",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf ./out && find ./src ./_src ./_test -type f \\( -name '*.d.ts' -o -name '*.js' \\) -delete",
    "build": "node esbuild.config.js",
    "build:test": "tsc --pretty false",
    "test:extension": "pnpm run clean && pnpm run build && pnpm run build:test && node scripts/run-extension-tests.mjs",
    "vscode:prepublish": "pnpm run clean && pnpm run build",
    "fmt": "dprint fmt",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && (dprint check || (dprint fmt && exit 1))",
    "vsix": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.13.2",
    "@types/vscode": "^1.98.0",
    "@vscode/test-electron": "^3.1.0",
    "annil": "^1.18.2",
    "dprint": "^0.54.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^16.5.0",
    "hry-types": "^0.19.3",
    "husky": "^9.1.7",
    "miniprogram-api-typings": "^5.2.1",
    "mobx": "^6.16.1",
    "mocha": "^10.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
