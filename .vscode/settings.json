{
  "files.exclude": {
    "out": false
  },
  "search.exclude": {
    "out": true
  },
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "annil.generatePath": "miniTest/components",
  "annil.generateAttrs": [
    "mode",
    "src",
    "hidden",
    "value",
    "placeholder",
    "scroll-into-view"
  ],
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "editor.defaultFormatter": "dprint.dprint",
  "editor.wordWrap": "on",
  "eslint.useFlatConfig": true,
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [
        "dprint.json"
      ],
      "url": "https://dprint.dev/schemas/v0.json"
    }
  ],
  "[typescript]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dprint.dprint"
  }
}
